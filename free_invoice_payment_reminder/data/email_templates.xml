<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- First Reminder QWeb Template -->
        <template id="email_template_first_reminder_qweb" name="Payment Reminder - First Notice">
            <t t-name="payment_reminder.first_notice">
                <div style="font-family: Arial, sans-serif; color: #333;">
                    <h2 style="color: #007bff;">Payment Reminder</h2>
                    <p>Dear <t t-esc="object.partner_id.name"/>,</p>

                    <p>This is a friendly reminder that invoice <strong t-esc="object.name"/>
                    is now <strong><t t-esc="object.days_overdue"/> days overdue</strong>.</p>

                    <table style="border-collapse: collapse; width: 100%; margin: 20px 0;">
                        <tr>
                            <td style="padding: 10px; border: 1px solid #ddd;"><strong>Invoice Number:</strong></td>
                            <td style="padding: 10px; border: 1px solid #ddd;" t-esc="object.name"/>
                        </tr>
                        <tr>
                            <td style="padding: 10px; border: 1px solid #ddd;"><strong>Invoice Date:</strong></td>
                            <td style="padding: 10px; border: 1px solid #ddd;" t-esc="object.invoice_date"/>
                        </tr>
                        <tr>
                            <td style="padding: 10px; border: 1px solid #ddd;"><strong>Due Date:</strong></td>
                            <td style="padding: 10px; border: 1px solid #ddd;" t-esc="object.invoice_date_due"/>
                        </tr>
                        <tr>
                            <td style="padding: 10px; border: 1px solid #ddd;"><strong>Amount Due:</strong></td>
                            <td style="padding: 10px; border: 1px solid #ddd; font-size: 18px; font-weight: bold; color: #007bff;">
                                <t t-esc="object.amount_residual" t-options="{'widget': 'monetary', 'display_currency': object.currency_id}"/>
                            </td>
                        </tr>
                    </table>

                    <p>Please arrange payment at your earliest convenience. If you have already made the payment,
                    please disregard this message.</p>

                    <p>If you have any questions, please don't hesitate to contact us.</p>

                    <p>Best regards,<br/>
                    <t t-esc="object.company_id.name"/><br/>
                    <t t-esc="object.company_id.email"/></p>
                </div>
            </t>
        </template>

        <!-- Mail Template Record for First Reminder -->
        <record id="email_template_first_reminder" model="mail.template">
            <field name="name">Payment Reminder - First Notice</field>
            <field name="model_id" ref="account.model_account_move"/>
            <field name="subject">Friendly Reminder: Invoice {{ object.name }} Payment Due</field>
            <field name="email_to">{{ object.partner_id.email }}</field>
            <field name="body_html" type="xml">
                <t t-call="invoice_payment_reminder.email_template_first_reminder_qweb"/>
            </field>
        </record>

        <!-- Second Reminder QWeb Template -->
        <template id="email_template_second_reminder_qweb" name="Payment Reminder - Second Notice">
            <t t-name="payment_reminder.second_notice">
                <div style="font-family: Arial, sans-serif; color: #333;">
                    <h2 style="color: #ff9800;">Payment Reminder - Second Notice</h2>
                    <p>Dear <t t-esc="object.partner_id.name"/>,</p>

                    <p>We previously contacted you regarding the overdue payment for invoice <strong t-esc="object.name"/>.</p>

                    <p style="color: #d32f2f; font-weight: bold;">
                        This invoice is now <strong><t t-esc="object.days_overdue"/> days overdue</strong>.
                    </p>

                    <table style="border-collapse: collapse; width: 100%; margin: 20px 0;">
                        <tr>
                            <td style="padding: 10px; border: 1px solid #ddd;"><strong>Invoice Number:</strong></td>
                            <td style="padding: 10px; border: 1px solid #ddd;" t-esc="object.name"/>
                        </tr>
                        <tr>
                            <td style="padding: 10px; border: 1px solid #ddd;"><strong>Due Date:</strong></td>
                            <td style="padding: 10px; border: 1px solid #ddd;" t-esc="object.invoice_date_due"/>
                        </tr>
                        <tr>
                            <td style="padding: 10px; border: 1px solid #ddd;"><strong>Amount Due:</strong></td>
                            <td style="padding: 10px; border: 1px solid #ddd; font-size: 20px; font-weight: bold; color: #d32f2f;">
                                <t t-esc="object.amount_residual" t-options="{'widget': 'monetary', 'display_currency': object.currency_id}"/>
                            </td>
                        </tr>
                    </table>

                    <p><strong>Please arrange immediate payment to avoid any service interruptions.</strong></p>

                    <p>If you are experiencing difficulties making this payment, please contact us immediately
                    to discuss payment arrangements.</p>

                    <p>Best regards,<br/>
                    <t t-esc="object.company_id.name"/><br/>
                    <t t-esc="object.company_id.email"/></p>
                </div>
            </t>
        </template>

        <!-- Mail Template Record for Second Reminder -->
        <record id="email_template_second_reminder" model="mail.template">
            <field name="name">Payment Reminder - Second Notice</field>
            <field name="model_id" ref="account.model_account_move"/>
            <field name="subject">Important: Invoice {{ object.name }} - Payment Overdue</field>
            <field name="email_to">{{ object.partner_id.email }}</field>
            <field name="body_html" type="xml">
                <t t-call="invoice_payment_reminder.email_template_second_reminder_qweb"/>
            </field>
        </record>

        <!-- Final Reminder QWeb Template -->
        <template id="email_template_final_reminder_qweb" name="Payment Reminder - Final Notice">
            <t t-name="payment_reminder.final_notice">
                <div style="font-family: Arial, sans-serif; color: #333;">
                    <h2 style="color: #d32f2f;">FINAL PAYMENT REMINDER</h2>
                    <p>Dear <t t-esc="object.partner_id.name"/>,</p>

                    <p style="font-size: 16px; color: #d32f2f; font-weight: bold;">
                        This is our FINAL REMINDER regarding the outstanding payment for invoice <t t-esc="object.name"/>.
                    </p>

                    <p>Despite our previous reminders, we have not yet received payment for this invoice.</p>

                    <table style="border-collapse: collapse; width: 100%; margin: 20px 0; border: 2px solid #d32f2f;">
                        <tr style="background-color: #ffebee;">
                            <td style="padding: 10px; border: 1px solid #d32f2f;"><strong>Invoice Number:</strong></td>
                            <td style="padding: 10px; border: 1px solid #d32f2f;" t-esc="object.name"/>
                        </tr>
                        <tr style="background-color: #ffebee;">
                            <td style="padding: 10px; border: 1px solid #d32f2f;"><strong>Days Overdue:</strong></td>
                            <td style="padding: 10px; border: 1px solid #d32f2f; font-weight: bold;">
                                <t t-esc="object.days_overdue"/> days
                            </td>
                        </tr>
                        <tr style="background-color: #ffebee;">
                            <td style="padding: 10px; border: 1px solid #d32f2f;"><strong>Amount Due:</strong></td>
                            <td style="padding: 10px; border: 1px solid #d32f2f; font-size: 22px; font-weight: bold; color: #d32f2f;">
                                <t t-esc="object.amount_residual" t-options="{'widget': 'monetary', 'display_currency': object.currency_id}"/>
                            </td>
                        </tr>
                    </table>

                    <div style="background-color: #fff3cd; padding: 15px; border-left: 4px solid #ff9800; margin: 20px 0;">
                        <p style="margin: 0;"><strong>IMMEDIATE ACTION REQUIRED:</strong></p>
                        <p style="margin: 5px 0 0 0;">Payment must be received within 48 hours to avoid further action,
                        which may include suspension of services and/or legal proceedings.</p>
                    </div>

                    <p>If you have already made this payment, please send us proof of payment immediately.</p>

                    <p>If you need to discuss payment arrangements, please contact us urgently at:</p>
                    <p><strong t-esc="object.company_id.phone"/> or <strong t-esc="object.company_id.email"/></p>

                    <p>Regards,<br/>
                    <t t-esc="object.company_id.name"/><br/>
                    Accounts Receivable Department</p>
                </div>
            </t>
        </template>

        <!-- Mail Template Record for Final Reminder -->
        <record id="email_template_final_reminder" model="mail.template">
            <field name="name">Payment Reminder - Final Notice</field>
            <field name="model_id" ref="account.model_account_move"/>
            <field name="subject">URGENT: Final Notice - Invoice {{ object.name }} Payment Required</field>
            <field name="email_to">{{ object.partner_id.email }}</field>
            <field name="body_html" type="xml">
                <t t-call="invoice_payment_reminder.email_template_final_reminder_qweb"/>
            </field>
        </record>

    </data>
</odoo>