<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Inherit Invoice Form View -->
    <record id="view_account_move_form_inherit_payment_reminder" model="ir.ui.view">
        <field name="name">account.move.form.inherit.payment.reminder</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">

            <!-- Add button in header -->
            <xpath expr="//header" position="inside">
                <button name="action_send_reminder_now"
                        string="Send Reminder"
                        type="object"
                        class="oe_highlight"
                        invisible="move_type != 'out_invoice' or state != 'posted' or payment_state in ['paid', 'in_payment']"
                        groups="account.group_account_invoice"/>
            </xpath>

            <!-- Add reminder info in form -->
            <xpath expr="//page[@name='other_info']" position="inside">
                <group string="Payment Reminders" name="payment_reminders">
                    <field name="reminder_count"/>
                    <field name="last_reminder_date"/>
                    <field name="days_overdue"/>
                </group>
            </xpath>

        </field>
    </record>

    <!-- Inherit Invoice Tree View -->
    <record id="view_account_move_tree_inherit_payment_reminder" model="ir.ui.view">
        <field name="name">account.move.tree.inherit.payment.reminder</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_out_invoice_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_partner_display_name']" position="after">
                <field name="reminder_count" optional="show"/>
            </xpath>
        </field>
    </record>

</odoo>